// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DocTest:inline_footnote > basic 1`] = `
"<div class="paragraph">
<p>Apocalyptic party.<sup class="footnote">[<a id="_footnoteref_1" class="footnote" href="#_footnotedef_1" title="View footnote.">1</a>]</sup></p>
</div>
<div id="footnotes">
<hr>
<div class="footnote" id="_footnotedef_1">
<a href="#_footnoteref_1">1</a>. The double hail-and-rainbow level makes my toes tingle.
</div>
</div>"
`;

exports[`DocTest:inline_footnote > xref 1`] = `
"<div class="paragraph">
<p>A bold statement.<sup class="footnote" id="_footnote_disclaimer">[<a id="_footnoteref_1" class="footnote" href="#_footnotedef_1" title="View footnote.">1</a>]</sup>
Another outrageous statement.<sup class="footnoteref">[<a class="footnote" href="#_footnotedef_1" title="View footnote.">1</a>]</sup></p>
</div>
<div id="footnotes">
<hr>
<div class="footnote" id="_footnotedef_1">
<a href="#_footnoteref_1">1</a>. Opinions are my own.
</div>
</div>"
`;

exports[`DocTest:inline_footnote > xref-unresolved 1`] = `
"<div class="paragraph">
<p>A bold statement.<sup class="footnoteref red" title="Unresolved footnote reference.">[foobar]</sup></p>
</div>"
`;
