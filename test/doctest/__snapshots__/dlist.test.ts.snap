exports[`DocTest:dlist > basic 1`] = `
"<div class="dlist">
<dl>
<dt class="hdlist1">Asciidoctor</dt>
<dd>
<p>An implementation of the AsciiDoc processor in Ruby.</p>
</dd>
<dt class="hdlist1">Asciidoc</dt>
<dd>
<p>A text document format for writing notes, documentation, articles, books,
ebooks, slideshows, web pages, man pages and blogs.</p>
</dd>
</dl>
</div>"
`;

exports[`DocTest:dlist > basic-block 1`] = `
"<div class="dlist">
<dl>
<dt class="hdlist1">About</dt>
<dd>
<div class="ulist">
<ul>
<li>
<p>An implementation of the AsciiDoc processor in Ruby.</p>
</li>
<li>
<p>Fast text processor and publishing toolchain.</p>
</li>
</ul>
</div>
</dd>
<dt class="hdlist1">Authors</dt>
<dd>
<p>Asciidoctor is lead by Dan Allen and Sarah White and has received contributions
from many other individuals in Asciidoctor’s awesome community.</p>
<div class="paragraph">
<p>AsciiDoc was started by Stuart Rackham.</p>
</div>
</dd>
</dl>
</div>"
`;

