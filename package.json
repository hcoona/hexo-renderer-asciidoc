{
  "name": "hexo-renderer-asciidoc",
  "version": "2.3.0-dev.1",
  "description": "Asciidoc renderer plugin for hexo",
  "type": "commonjs",
  "main": "index.js",
  "types": "./types/index.d.ts",
  "files": [
    "index.js",
    "lib",
    "types",
    "README.adoc"
  ],
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:md",
    "lint:biome": "pnpm exec biome lint --reporter summary .",
    "lint:md": "pnpm exec prettier --check \"**/*.{md,mdx,markdown}\"",
    "format": "pnpm run format:biome && pnpm run format:md",
    "format:biome": "pnpm exec biome format .",
    "format:md": "pnpm exec prettier --write \"**/*.{md,mdx,markdown}\"",
    "hooks:install": "hk install",
    "hooks:check": "hk check",
    "hooks:fix": "hk fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ./scripts/build.js",
    "prepublishOnly": "pnpm run build",
    "test": "mocha test/index.js",
    "test-cov": "nyc mocha -- test/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hcoona/hexo-renderer-asciidoc.git"
  },
  "keywords": [
    "hexo",
    "asciidoc"
  ],
  "author": "Zhang Shuai",
  "license": "LGPL-3.0-or-later WITH LGPL-3.0-linking-exception",
  "bugs": {
    "url": "https://github.com/hcoona/hexo-renderer-asciidoc/issues"
  },
  "homepage": "https://github.com/hcoona/hexo-renderer-asciidoc",
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "hexo": ">=8.0.0"
  },
  "dependencies": {
    "asciidoctor": "3.0.4",
    "cheerio": "0.22.0",
    "entities": "^4.5.0",
    "hexo-util": "3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "^22.10.2",
    "chai": ">=4.2.0 <5.0",
    "coveralls": "^3.1.1",
    "eclint": "^2.8.1",
    "hexo": "^8.1.1",
    "hexo-fs": "^4.1.3",
    "nyc": "^15.1.0",
    "markdownlint-cli2": "0.19.0",
    "mocha": "^10.4.0",
    "mocha-lcov-reporter": "^1.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.6.3"
  },
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js",
      "types": "./types/index.d.ts"
    },
    "./lib/renderer": {
      "require": "./lib/renderer.js",
      "import": "./lib/renderer.js"
    }
  },
  "packageManager": "pnpm@10.22.0"
}
