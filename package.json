{
  "name": "hexo-renderer-asciidoc",
  "version": "2.3.0-dev.1",
  "description": "Asciidoc renderer plugin for hexo",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "lint": "pnpm run lint:biome && pnpm run lint:md",
    "lint:biome": "pnpm exec biome lint --reporter summary .",
    "lint:md": "pnpm exec prettier --check \"**/*.{md,mdx,markdown}\"",
    "format": "pnpm run format:biome && pnpm run format:md",
    "format:biome": "pnpm exec biome format .",
    "format:md": "pnpm exec prettier --write \"**/*.{md,mdx,markdown}\"",
    "hooks:install": "hk install",
    "hooks:check": "hk check",
    "hooks:fix": "hk fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-cov": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hcoona/hexo-renderer-asciidoc.git"
  },
  "keywords": [
    "hexo",
    "asciidoc"
  ],
  "author": "Zhang Shuai",
  "license": "LGPL-3.0-or-later WITH LGPL-3.0-linking-exception",
  "bugs": {
    "url": "https://github.com/hcoona/hexo-renderer-asciidoc/issues"
  },
  "homepage": "https://github.com/hcoona/hexo-renderer-asciidoc",
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "hexo": ">=8.0.0"
  },
  "dependencies": {
    "asciidoctor": "3.0.4",
    "cheerio": "0.22.0",
    "entities": "^4.5.0",
    "hexo-util": "3.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.9",
    "markdownlint-cli2": "0.19.0",
    "prettier": "3.6.2",
    "tsdown": "^0.16.4",
    "typescript": "^5.6.3",
    "vitest": "^4.0.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@10.22.0"
}
